FROM node:22-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm install

ARG VITE_PORT=5188
ARG VITE_FILE_SERVICE_URL=http://localhost:3224
ARG VITE_FILE_SERVICE_AUTH=
ARG VITE_SONJA_PROMPT_PREFIX=sonja file
ENV VITE_PORT=$VITE_PORT
ENV VITE_FILE_SERVICE_URL=$VITE_FILE_SERVICE_URL
ENV VITE_FILE_SERVICE_AUTH=$VITE_FILE_SERVICE_AUTH
ENV VITE_SONJA_PROMPT_PREFIX=$VITE_SONJA_PROMPT_PREFIX

COPY . .
RUN npm run build

EXPOSE 5188

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5188"]
