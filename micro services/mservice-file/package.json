{
  "name": "mservice-file",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "nodemon --watch src --watch restart.version --ext ts,json,version --exec \"tsx src/index.ts\"",
    "nodemon": "nodemon --watch src --watch restart.version --ext ts,json,version --exec \"tsx src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "restart:service": "node scripts/bump-restart-version.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.891.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}