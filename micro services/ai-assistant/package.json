{
  "name": "ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "My Personal AI assistant webhook server",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --watch prompts --watch restart.version --ext ts,html,json,version --exec \"node --import tsx src/server.ts\"",
    "nodemon": "nodemon --watch src --watch prompts --watch restart.version --ext ts,html,json,version --exec \"node --import tsx src/server.ts\"",
    "restart:service": "node scripts/bump-restart-version.mjs"
  },
  "dependencies": {
    "@openai/codex": "^0.101.0",
    "@popperjs/core": "2.11.8",
    "better-sqlite3": "^12.6.2",
    "bootstrap": "5.3.3",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3",
    "uuid": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bootstrap": "^5",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.12",
    "nodemon": "^3.1.9",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
